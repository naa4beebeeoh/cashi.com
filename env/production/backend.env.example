# Production — replace placeholders; secrets come from the deploy vault / CI, never git.
# APP_ENV=production fails closed: DATABASE_URL and REDIS_URL are required (no localhost defaults).
APP_ENV=production
API_ADDR=:8080
DATABASE_URL=postgres://cashi:CHANGE_ME@prod-db:5432/cashi?sslmode=require
REDIS_URL=redis://prod-redis:6379/0
